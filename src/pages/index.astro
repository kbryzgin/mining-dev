---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Plexus from '../components/Plexus.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const services=[{n:'01',title:'Разработка',desc:'Встраиваемые модули для ГГИС, автономные приложения и специализированные алгоритмы. Доработка и развитие существующего ПО.',tags:'Модули · Приложения · Алгоритмы',href:'/services/development'},{n:'02',title:'Автоматизация',desc:'Автоматизация операций и производственных процессов в ГГИС, построение рабочих последовательностей и взаимодействие с внешними инструментами.',tags:'Процессы · Python · Инструменты',href:'/services/automation'},{n:'03',title:'Обучение',desc:'Корпоративное обучение Python и SQL для специалистов горно-геологических подразделений на примерах производственных задач.',tags:'Python · SQL · Практика',href:'/services/training'}];
const problems=[['Стандартных возможностей ГГИС недостаточно','Разрабатываю специализированные модули и приложения, расширяющие возможности существующих инструментов.'],['Производственные операции требуют ручной работы','Автоматизирую повторяющиеся действия и связываю операции в последовательные рабочие процессы.'],['Инструменты и источники данных разрознены','Организую взаимодействие ГГИС с внешними программными инструментами в рамках автоматизированных процессов.'],['Необходимы специализированные расчёты','Разрабатываю алгоритмы и вычислительные компоненты под конкретные геологические и горно-технические задачи.'],['Существующее ПО нужно развивать','Дорабатываю программные решения, изменяю логику, добавляю функции и сопровождаю инструменты.'],['Команде не хватает технических компетенций','Провожу корпоративное обучение Python и SQL с практическими примерами.']];
const cases=[{n:'01',title:'Редактирование геометрии выемочных единиц',desc:'Инструмент для редактирования каркасной геометрии ЭВЕ с автоматическим или задаваемым направлением экструзии.',tech:'Micromine Python API · PyVista',href:'/solutions/geometry-editing'},{n:'02',title:'Расчёт фактических направлений выемочных работ',desc:'Алгоритм определения фактического направления отработки ЭВЕ по точкам копания и сопоставления с проектным.',tech:'Micromine Python API · Python',href:'/solutions/mining-directions'},{n:'03',title:'Модуль сверки и анализа горных операций',desc:'Комплекс взаимосвязанных программных компонентов для консолидации данных и расчёта показателей.',tech:'Micromine Python API · Python',href:'/solutions/reconciliation'}];
---
<BaseLayout>
<section class="hero"><Plexus/><div class="hero-vignette"></div><div class="container hero-inner"><div class="hero-copy"><span class="eyebrow"><i></i>ЧАСТНАЯ ИНЖЕНЕРНАЯ ПРАКТИКА · РАЗРАБОТКА ПО</span><h1>Разработка и автоматизация ГГИС</h1><p class="hero-subtitle">Инженерные решения для геологии и горного производства</p><p class="hero-lead">Разрабатываю программные модули, автоматизирую производственные процессы и расширяю возможности ГГИС под реальные задачи предприятия. Работаю с различными платформами при наличии API и средств программной интеграции.</p><div class="hero-actions"><a class="button button-primary" href="/contacts">Обсудить задачу <span>↗</span></a><a class="text-link" href="/solutions">Посмотреть решения <span>→</span></a></div><div class="hero-note"><span class="status-dot"></span>Прямое взаимодействие с заказчиком · Понимание предметной области · Инженерный подход</div></div></div></section>
<section class="trust-strip"><div class="container trust-inner"><span>ОСНОВНАЯ СПЕЦИАЛИЗАЦИЯ</span><b>ГГИС</b><i></i><b>Геология и горное производство</b><i></i><b>Разработка</b><i></i><b>Автоматизация</b></div></section>
<section class="section container" id="services"><SectionHeading eyebrow="НАПРАВЛЕНИЯ РАБОТЫ" title="От производственной задачи до работающего инструмента" text="Основные направления работы."/><div class="service-grid">{services.map(s=><a class="service-card" href={s.href}><div class="card-top"><span>{s.n} · УСЛУГА</span><span class="card-arrow">↗</span></div><h3>{s.title}</h3><p>{s.desc}</p><div class="card-tags">{s.tags}</div></a>)}</div></section>
<section class="section container" id="tasks"><SectionHeading eyebrow="ЗАДАЧИ И РЕШЕНИЯ" title="Какие задачи решаю" text="Адаптирую инструменты под производственные задачи, а не наоборот."/><div class="problem-grid">{problems.map((p,i)=><article class="problem-card"><span class="problem-number">{String(i+1).padStart(2,'0')}</span><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div></section>
<section class="approach"><div class="container approach-grid"><div><span class="eyebrow">ПОДХОД К РАБОТЕ</span><h2>Не просто написать код.<br/><em>Разобраться в задаче.</em></h2></div><div class="approach-copy"><p>Производственные задачи редко укладываются в стандартный функционал ПО. Поэтому я начинаю с понимания процесса, ограничений и ожидаемого результата — и только затем выбираю архитектуру и инструменты.</p><div class="principles"><div><b>01</b><span><strong>Погружение в предметную область</strong><small>Понимание геологических и маркшейдерских процессов.</small></span></div><div><b>02</b><span><strong>Осмысленная инженерия</strong><small>Понятная архитектура, проверяемые алгоритмы, документация.</small></span></div><div><b>03</b><span><strong>Практический результат</strong><small>Инструмент, который решает конкретную задачу производства.</small></span></div></div></div></div></section>
<section class="section container"><SectionHeading eyebrow="ТЕХНОЛОГИИ И ИНСТРУМЕНТЫ" title="Инструменты разработки" text="Основное направление работы с ГГИС — разработка и автоматизация процессов с использованием API."/><div class="technology-grid"><article><span>ГГИС</span><h3>Горно-геологические информационные системы</h3><p>Разработка и автоматизация с использованием API.</p></article><article><span>РАЗРАБОТКА</span><h3>Python · C · C++</h3><p>Прикладная логика, обработка данных и программные компоненты.</p></article><article><span>ИНЖЕНЕРИЯ</span><h3>Алгоритмы</h3><p>Вычислительная геометрия и пространственные алгоритмы.</p></article></div></section>
<section class="section container"><div class="split-heading"><SectionHeading eyebrow="ПРИМЕРЫ РАБОТ" title="Реализованные решения" text="Примеры специализированных инструментов и программных модулей для задач горного производства."/><a class="text-link desktop-link" href="/solutions">Все проекты →</a></div><div class="case-grid">{cases.map(c=><a class="case-card" href={c.href}><div class="card-top"><span>ПРОЕКТ · {c.n}</span><span class="card-arrow">↗</span></div><h3>{c.title}</h3><p>{c.desc}</p><span class="case-tech">{c.tech}</span></a>)}</div></section>
<section class="section container about-teaser"><div><span class="eyebrow">ПРОФЕССИОНАЛЬНЫЙ ПРОФИЛЬ</span><h2>Программная инженерия<br/><em>с пониманием геологии.</em></h2></div><div><p>Я IT-разработчик для горно-геологической отрасли. Мой опыт объединяет разработку программных модулей, автоматизацию инженерных процессов, опыт участия в проектах разработки горно-геологических информационных платформ и восемь лет работы в горной геологии.</p><a class="text-link" href="/about">Подробнее обо мне →</a></div></section>
<section class="section container"><div class="split-heading"><SectionHeading eyebrow="БЛОГ" title="Разбираю технологии без чёрных ящиков" text="Заметки о разработке ГГИС, автоматизации, алгоритмах и программной инженерии."/><a class="text-link desktop-link" href="/blog">Все публикации →</a></div><div class="post-grid">{posts.length?posts.map(post=><a class="post-card" href={`/blog/${post.id}`}><span class="post-meta">{post.data.category} <i>·</i> {post.data.pubDate.toLocaleDateString('ru-RU')}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-more">Читать статью →</span></a>):<div class="empty-posts">Технические материалы готовятся к публикации. <a href="/blog">Перейти в блог →</a></div>}</div></section>
<section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">ОБСУДИМ ВАШУ ЗАДАЧУ</span><h2>Давайте разберёмся,<br/><em>что можно сделать.</em></h2></div><a class="button button-primary" href="/contacts">Обсудить задачу <span>↗</span></a></div></section>
</BaseLayout>
