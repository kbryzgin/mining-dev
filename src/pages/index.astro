---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Plexus from '../components/Plexus.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const services = [
  {
    title: 'Разработка',
    description: 'Создаю встраиваемые модули для ГГИС, автономные приложения и специализированные расчётные алгоритмы.',
    href: '/services/development',
  },
  {
    title: 'Автоматизация',
    description: 'Автоматизирую повторяющиеся операции, пакетную обработку данных и обмен между ГГИС и внешними инструментами.',
    href: '/services/automation',
  },
];
const cases = [
  {
    title: 'SMU Geometry Editor',
    description: 'Пакетное редактирование каркасных моделей выемочных единиц непосредственно в Micromine.',
    context: 'Каркасные модели',
    href: '/solutions/geometry-editing',
  },
  {
    title: 'Mining Direction Control',
    description: 'Расчёт фактических азимутов по точкам копания и выявление блоков с отклонением от плана.',
    context: 'Контроль отработки',
    href: '/solutions/mining-directions',
  },
  {
    title: 'Reconcil',
    description: 'Сводный отчёт для сопоставления плановых и фактических показателей горных работ.',
    context: 'Реконсиляция',
    href: '/solutions/reconciliation',
  },
];
---
<BaseLayout>
  <section class="hero">
    <Plexus />
    <div class="hero-vignette"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Разработка и автоматизация ГГИС</h1>
        <p class="hero-lead">Разрабатываю программные модули и автоматизирую рабочие процессы для геологии и горного производства.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={withBase('/contacts')}>Обсудить задачу</a>
          <a class="button button-secondary" href="#projects">Посмотреть решения</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container home-section" id="services">
    <SectionHeading title="Услуги" />
    <div class="service-grid">
      {services.map(service => (
        <a class="home-card" href={withBase(service.href)}>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <span class="card-link">Подробнее</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" id="projects">
    <div class="home-section-heading">
      <SectionHeading title="Реализованные решения" />
      <a class="text-link" href={withBase('/solutions')}>Все проекты</a>
    </div>
    <div class="project-grid">
      {cases.map(project => (
        <a class="home-card project-card" href={withBase(project.href)}>
          <span class="project-context">{project.context}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="card-link">Смотреть кейс</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach">
    <div class="container approach-grid">
      <div><h2>Разработка с опытом в горной геологии</h2></div>
      <div class="approach-copy">
        <p>Я геолог-разработчик с восьмилетним опытом в горной геологии. Работаю с API горно-геологических систем, разрабатываю прикладные инструменты на Python и вычислительные компоненты на C.</p>
        <p>Работаю напрямую с заказчиком. Обсуждаем, как устроен процесс, согласуем требования и уточняем решение по мере работы.</p>
        <a class="text-link" href={withBase('/about')}>Подробнее обо мне</a>
      </div>
    </div>
  </section>

  <section class="container home-section">
    <div class="home-section-heading">
      <SectionHeading title="Блог" text="Заметки о разработке для ГГИС, автоматизации и вычислительных алгоритмах." />
      <a class="text-link" href={withBase('/blog')}>Все публикации</a>
    </div>
    {posts.length > 0 && (
      <div class="home-post-grid">
        {posts.map(post => (
          <a class="home-card" href={withBase(`/blog/${post.id}`)}>
            <span class="project-context">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="card-link">Читать статью</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="contact-band">
    <div class="container contact-band-inner">
      <h2>Есть задача для разработки или автоматизации?</h2>
      <a class="button button-primary" href={withBase('/contacts')}>Обсудить задачу</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero,
  .hero-inner {
    min-height: clamp(460px, 67vh, 650px);
  }

  .hero h1 {
    max-width: 15ch;
    margin-top: 0;
    text-wrap: balance;
  }

  .hero-lead {
    max-width: 48ch;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .hero-actions {
    flex-flow: row wrap;
    gap: 12px;
  }

  .button {
    font-size: .875rem;
  }

  .button-secondary {
    border-color: var(--accent-dim);
    background: var(--bg);
  }

  .button-secondary:hover {
    border-color: var(--accent);
    background: var(--panel-raised);
  }

  .home-section {
    padding-block: clamp(52px, 7vw, 88px);
  }

  #projects {
    border-top: 1px solid var(--line);
  }

  .home-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .home-section :global(.section-heading h2) {
    margin-top: 0;
  }

  .home-section :global(.section-heading p),
  .approach-copy p {
    font-size: 1rem;
    line-height: 1.65;
  }

  .approach-copy p + p {
    margin-top: 16px;
  }

  .approach h2,
  .contact-band h2 {
    margin-top: 0;
  }

  .text-link {
    font-size: .875rem;
  }

  .service-grid,
  .project-grid,
  .home-post-grid {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-post-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
  }

  .home-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    transition: border-color .2s, background .2s;
  }

  .home-card:hover,
  .home-card:focus-visible {
    border-color: var(--accent-dim);
    background: var(--panel-raised);
  }

  .home-card h3 {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .home-card p {
    max-width: 50ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .project-card {
    border-top: 2px solid var(--accent-dim);
  }

  .project-context {
    color: var(--muted);
    font-size: .875rem;
  }

  .card-link {
    margin-top: auto;
    padding-top: 8px;
    color: var(--accent);
    font-size: .875rem;
  }

  .contact-band .button {
    flex-shrink: 0;
  }

  @media (max-width: 800px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
