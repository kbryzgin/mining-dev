---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items=[{n:'01',title:'Разработка',intro:'Создаю программные решения для различных ГГИС и горно-геологических задач: от встраиваемых модулей до автономных приложений и специализированных алгоритмов.',points:['Встраиваемые программные модули для ГГИС','Автономные приложения и специализированные утилиты','Алгоритмы и вычислительные компоненты','Доработка, развитие и сопровождение существующего ПО'],href:'/services/development'},{n:'02',title:'Автоматизация',intro:'Автоматизирую операции и производственные процессы в ГГИС, объединяю отдельные действия в последовательные рабочие процессы.',points:['Автоматизация операций внутри ГГИС','Построение последовательностей обработки данных','Пакетная обработка и контроль результатов','Интеграция ГГИС с внешними инструментами в рамках автоматизированных процессов'],href:'/services/automation'}];
---
<BaseLayout title="Услуги — Mining-Dev" description="Разработка программного обеспечения для ГГИС и автоматизация производственных процессов."><section class="page-hero container"><span class="eyebrow">УСЛУГИ</span><h1>Разработка и автоматизация<br/><em>для ГГИС</em></h1><p>Создаю инструменты для горно-геологических задач и автоматизирую повторяющиеся производственные операции.</p></section><section class="container service-detail-list">{items.map(item=><article class="service-detail"><div class="detail-number">{item.n}</div><div><h2>{item.title}</h2><p class="detail-intro">{item.intro}</p><ul>{item.points.map(p=><li>{p}</li>)}</ul><a class="text-link" href={withBase(item.href)}>Подробнее →</a></div></article>)}</section><section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">СЛЕДУЮЩИЙ ШАГ</span><h2>Опишите задачу —<br/><em>обсудим решение.</em></h2></div><a class="button button-primary" href={withBase("/contacts")}>Связаться <span>↗</span></a></div></section></BaseLayout>
