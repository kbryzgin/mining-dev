---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
const topics=[["Встраиваемые модули", "Разработка встраиваемых модулей, которые работают в среде ГГИС и расширяют стандартные возможности системы."], ["Автономные приложения", "Отдельные приложения и утилиты для специализированных задач."], ["Алгоритмы и вычислительные компоненты", "Реализация расчетных движков, компонентов, библиотек."], ["Развитие существующего ПО", "Доработка логики, добавление функций, исправление ошибок и сопровождение используемых программных решений."]];
---
<BaseLayout title="Разработка программного обеспечения — Mining-Dev" description="Разрабатываю решения для различных ГГИС и специализированные приложения для задач геологии и горного производства. Работаю с программными интерфейсами систем через API и SDK, либо разрабатываю собственные программные компоненты."><section class="page-hero container"><span class="eyebrow">УСЛУГИ · РАЗРАБОТКА</span><h1>Разработка программного обеспечения</h1><p>Разрабатываю решения для различных ГГИС и специализированные приложения для задач геологии и горного производства. Работаю с программными интерфейсами систем через API и SDK, либо разрабатываю собственные программные компоненты.</p></section><section class="container detail-content"><h2>Что входит в работу</h2><div class="detail-topic-grid">{topics.map(item=><article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div><h2>Результат</h2><p>Результатом становится специализированный программный инструмент, встроенный в существующий рабочий процесс или работающий как самостоятельное приложение.</p></section><section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">ОБСУДИМ ЗАДАЧУ</span><h2>Есть задача для разработки<br/><em>или автоматизации?</em></h2></div><a class="button button-primary" href={withBase("/contacts")}>Написать мне <span>↗</span></a></div></section></BaseLayout>
