---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
const topics=[["Python", "Основы языка, типы данных, условия, циклы, функции, модули и организация кода."], ["Python API ГГИС", "Знакомство с API и объектными моделями ГГИС, разработка пользовательских инструментов."], ["Автоматизация", "Применение Python для автоматизации типовых операций и рабочих последовательностей."], ["SQL и базы данных", "Запросы, фильтрация, соединения таблиц, группировка, агрегирование и представления."]];
---
<BaseLayout title="Корпоративное обучение Python и SQL — Mining-Dev" description="Практическое обучение для специалистов горно-геологических подразделений, которым нужны навыки программирования и работы с данными."><section class="page-hero container"><span class="eyebrow">УСЛУГИ · ОБУЧЕНИЕ</span><h1>Корпоративное обучение Python и SQL</h1><p>Практическое обучение для специалистов горно-геологических подразделений, которым нужны навыки программирования и работы с данными.</p></section><section class="container detail-content"><h2>Что входит в работу</h2><div class="detail-topic-grid">{topics.map(item=><article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div><h2>Результат</h2><p>Обучение ориентировано на практику: упражнения и примеры связываются с задачами специалистов в работе.</p></section><section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">ОБСУДИМ ЗАДАЧУ</span><h2>Есть задача для разработки<br/><em>или автоматизации?</em></h2></div><a class="button button-primary" href={withBase("/contacts")}>Написать мне <span>↗</span></a></div></section></BaseLayout>
