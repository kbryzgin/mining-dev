---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
const topics=[["Операции в ГГИС", "Перевод повторяющихся действий в автоматизированные операции."], ["Создание конвейров обработки", "Построение взаимосвязанных этапов обработки, в которых данные и результаты передаются между операциями."], ["Организация данных в проекте", "Организация и согласование взаимосвязанных данных, систематизация, логирование."], ["Внешние инструменты", "Интеграция ГГИС с базами данных и специализированными приложениями в рамках автоматизированного процесса."]];
---
<BaseLayout title="Автоматизация процессов в ГГИС — Mining-Dev" description="Автоматизирую повторяющиеся операции и связываю действия в последовательные производственные процессы внутри ГГИС и с использованием внешних инструментов."><section class="page-hero container"><span class="eyebrow">УСЛУГИ · АВТОМАТИЗАЦИЯ</span><h1>Автоматизация процессов в ГГИС</h1><p>Автоматизирую повторяющиеся операции геолого-маркшейдерского сопровождения в ГГИС.</p></section><section class="container detail-content"><h2>Что входит в работу</h2><div class="detail-topic-grid">{topics.map(item=><article><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div><h2>Результат</h2><p>Цель автоматизации — уменьшить объём ручных действий, снизить вероятность ошибок и сделать процесс более понятным и воспроизводимым.</p></section><section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">ОБСУДИМ ЗАДАЧУ</span><h2>Есть задача для разработки<br/><em>или автоматизации?</em></h2></div><a class="button button-primary" href={withBase("/contacts")}>Написать мне <span>↗</span></a></div></section></BaseLayout>
