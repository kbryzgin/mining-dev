import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Расчёт фактических направлений выемочных работ — Mining-Dev" description="Инструмент для анализа проектных и фактических направлений отработки выемочных единиц по данным точек копания."><section class="page-hero container"><span class="eyebrow">ПРИМЕР РАБОТЫ</span><h1>Mining Directions Tool</h1><p>Разработка инструмента для расчета фактических направлений ведения горных работ в Micromine.</p></section><section class="container detail-content case-detail"><h2>Задача</h2><p>Разработка инструмента для Micromine, предназначенного для расчета фактических направлений выемочных работ по точкам копания из системы диспетчеризации, необходимых для анализа отклонений от плановых решений.</p><h2>Техническая реализация</h2><p>Разработан алгоритм, который определяет точки копания, расположенные внутри геометрии соответствующей ЭВЕ, и рассчитывает по ним общее фактическое направление выемочных работ. Полученный результат позволяет сопоставить направление фактической отработки с проектным направлением.</p><h2>Результат</h2><p>Создан аналитический инструмент в рабочем пространстве Micromine, расширяющий стандартные возможности ГГИС и позволяющий оценивать, в каком направлении ЭВЕ должна была отрабатываться по проекту и в каком направлении велась фактически.</p><h2>Технологии</h2><p class="case-tech">Micromine Python API · Python</p><a class="text-link" href={withBase("/solutions")}>← Все проекты</a></section><section class="contact-band"><div class="container contact-band-inner"><div><span class="eyebrow">ПОХОЖАЯ ЗАДАЧА?</span><h2>Обсудим возможное<br/><em>техническое решение.</em></h2></div><a class="button button-primary" href={withBase("/contacts")}>Связаться <span>↗</span></a></div></section></BaseLayout>
