---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
const projects=[{n:'01',title:'SMU Geometry Editor',desc:'Разработка встраиваемого программного модуля для Micromine, предназначенного для редактирования геометрии трёхмерных каркасных моделей (TRIDB).',tech:'Python 3.8 · PyQt5· PyVista · VTK · NumPy · SQLite · Micromine Python API',href:'/solutions/geometry-editing'},{n:'02',title:'Mining Directions Tool',desc:'Разработка инструмента для расчета фактических направлений ведения горных работ в Micromine.',tech:'Micromine Python API · Python',href:'/solutions/mining-directions'},{n:'03',title:'Reconcil',desc:'Автоматизация процесса сопоставления плановых и фактических показателей горных работ.',tech:'Python 3.8 · PyQt5 · NumPy · Micromine Python API · Python Logging · Windows API',href:'/solutions/reconciliation'}];
---
<BaseLayout title="Реализованные решения — Mining-Dev" description="Примеры разработки программных модулей и инструментов для горно-геологических задач."><section class="page-hero container"><span class="eyebrow">РЕАЛИЗОВАННЫЕ ПРОЕКТЫ</span><h1>Решения для задач,<br/><em>которым тесно в стандартном ПО.</em></h1><p>Примеры реализованных программных инструментов: постановка задачи, технический подход и результат.</p></section><section class="container case-grid case-list">{projects.map(p=><a class="case-card" href={withBase(p.href)}><div class="card-top"><span>ПРОЕКТ · {p.n}</span><span class="card-arrow">↗</span></div><h3>{p.title}</h3><p>{p.desc}</p><span class="case-tech">{p.tech}</span><span class="read-more">Подробнее о проекте →</span></a>)}</section></BaseLayout>
