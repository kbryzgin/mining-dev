---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
const projects=[{n:'01',title:'Редактирование геометрии выемочных единиц',desc:'Специализированный алгоритм экструзии каркасной геометрии ЭВЕ с автоматическим или ручным заданием направления.',tech:'Micromine Python API · PyVista',href:'/solutions/geometry-editing'},{n:'02',title:'Расчёт фактических направлений выемочных работ',desc:'Расчёт общего фактического направления отработки ЭВЕ по точкам копания внутри её геометрии.',tech:'Micromine Python API · Python',href:'/solutions/mining-directions'},{n:'03',title:'Модуль сверки и анализа горных операций',desc:'Комплекс программных компонентов в едином подпроекте Micromine для консолидации данных по датам и расчёта показателей.',tech:'Micromine Python API · Python',href:'/solutions/reconciliation'}];
---
<BaseLayout title="Реализованные решения — Mining-Dev" description="Примеры разработки программных модулей и инструментов для горно-геологических задач."><section class="page-hero container"><span class="eyebrow">РЕАЛИЗОВАННЫЕ ПРОЕКТЫ</span><h1>Решения для задач,<br/><em>которым тесно в стандартном ПО.</em></h1><p>Примеры реализованных программных инструментов: постановка задачи, технический подход и результат.</p></section><section class="container case-grid case-list">{projects.map(p=><a class="case-card" href={withBase(p.href)}><div class="card-top"><span>ПРОЕКТ · {p.n}</span><span class="card-arrow">↗</span></div><h3>{p.title}</h3><p>{p.desc}</p><span class="case-tech">{p.tech}</span><span class="read-more">Подробнее о проекте →</span></a>)}</section></BaseLayout>
