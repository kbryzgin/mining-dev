<canvas class="plexus-canvas" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.plexus-canvas');
  const host = canvas?.parentElement;
  const context = canvas?.getContext('2d');

  if (canvas && host && context) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const theme = getComputedStyle(host);
    const lineColor = theme.getPropertyValue('--accent').trim();
    const columns = 18;
    const rows = 14;
    let width = 1;
    let height = 1;
    let frame = 0;

    function draw(time: number) {
      const phase = time / 1800;
      const scale = Math.min(width / 23, height / 15);
      const originX = width * (width < 680 ? .66 : .74);
      const originY = height * .51;
      const points = Array.from({ length: rows }, (_, row) =>
        Array.from({ length: columns }, (_, column) => {
          const x = column - (columns - 1) / 2;
          const depth = row - (rows - 1) / 2;
          const rim = column + row * .54;
          const elevation = Math.floor(rim / 4) * 1.25;
          const sway = Math.sin(phase + x * .32 + depth * .24) * .18;
          return {
            x: originX + (x - depth * .55) * scale,
            y: originY + (depth * .48 + x * .2 - elevation + sway) * scale,
          };
        })
      );

      context!.clearRect(0, 0, width, height);
      context!.strokeStyle = lineColor;
      context!.lineWidth = 1;
      for (let row = 0; row < rows - 1; row++) {
        for (let column = 0; column < columns - 1; column++) {
          const point = points[row][column];
          const right = points[row][column + 1];
          const below = points[row + 1][column];
          const diagonal = points[row + 1][column + 1];
          const edge = Math.min(row + 1, rows - row - 1, column + 1, columns - column - 1);
          context!.globalAlpha = Math.min(edge / 4, 1) * .42;
          context!.beginPath();
          context!.moveTo(point.x, point.y);
          context!.lineTo(right.x, right.y);
          context!.lineTo(below.x, below.y);
          context!.closePath();
          context!.moveTo(right.x, right.y);
          context!.lineTo(diagonal.x, diagonal.y);
          context!.lineTo(below.x, below.y);
          context!.stroke();
        }
      }
      context!.globalAlpha = 1;
    }

    function animate(time: number) {
      draw(time);
      frame = requestAnimationFrame(animate);
    }

    function refresh() {
      cancelAnimationFrame(frame);
      if (motion.matches || document.hidden) draw(0);
      else frame = requestAnimationFrame(animate);
    }

    new ResizeObserver(([entry]) => {
      ({ width, height } = entry.contentRect);
      const density = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(width * density));
      canvas.height = Math.max(1, Math.round(height * density));
      context.setTransform(density, 0, 0, density, 0, 0);
      refresh();
    }).observe(host);

    motion.addEventListener('change', refresh);
    document.addEventListener('visibilitychange', refresh);
  }
</script>
