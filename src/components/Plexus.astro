<canvas class="plexus-canvas" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.plexus-canvas');
  const host = canvas?.parentElement;
  const ctx = canvas?.getContext('2d');

  if (canvas && host && ctx) {
    // Параметры и алгоритм взяты из пользовательского index(5).html.
    // Изменена только привязка размеров canvas к hero-блоку сайта.
    const N = 450;
    const maxD = 65;
    const BINARY_COUNT = 45;
    const pts: Array<{x:number;y:number;z:number;vx:number;vy:number;vz:number}> = [];
    const binPts: Array<{x:number;y:number;z:number;char:string;vx:number;vy:number;vz:number;glowPhase:number;glowSpeed:number}> = [];
    const binCanvases: Record<number, Record<string, HTMLCanvasElement>> = {};

    let w = 1, h = 1, cx = 0, cy = 0;
    let mx = 0, my = 0, rx = 0, ry = 0;
    let raf = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function preRenderBinaries() {
      [10, 14, 18, 24].forEach((size) => {
        binCanvases[size] = {};
        (['0', '1'] as const).forEach((char) => {
          const bCanvas = document.createElement('canvas');
          bCanvas.width = size * 3;
          bCanvas.height = size * 3;
          const bCtx = bCanvas.getContext('2d');
          if (!bCtx) return;
          bCtx.filter = 'blur(1px)';
          bCtx.font = `bold ${size}px monospace`;
          bCtx.fillStyle = 'rgba(70, 160, 220, 0.35)';
          bCtx.textAlign = 'center';
          bCtx.textBaseline = 'middle';
          bCtx.fillText(char, bCanvas.width / 2, bCanvas.height / 2);
          binCanvases[size][char] = bCanvas;
        });
      });
    }

    function resize() {
      const rect = host!.getBoundingClientRect();
      w = Math.max(1, rect.width);
      h = Math.max(1, rect.height);
      cx = w / 2;
      cy = h / 2;

      // Как в оригинале: backing store равен CSS-размеру, без DPR-увеличения.
      canvas!.width = Math.round(w);
      canvas!.height = Math.round(h);
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(host);
    resize();

    host.addEventListener('pointermove', (event: PointerEvent) => {
      const rect = host!.getBoundingClientRect();
      mx = (event.clientX - rect.left - cx) / cx;
      my = (event.clientY - rect.top - cy) / cy;
    }, { passive: true });
    host.addEventListener('pointerleave', () => { mx = 0; my = 0; });

    // Структурированный волнистый 3D-ландшафт — исходная формула пользователя.
    for (let i = 0; i < N; i++) {
      const x = (Math.random() - 0.5) * 1100;
      const z = (Math.random() - 0.5) * 700 + 450;
      const y = Math.sin(x * 0.007) * Math.cos((z - 450) * 0.007) * 110 + (Math.random() - 0.5) * 20;
      pts.push({
        x, y, z,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.15,
        vz: (Math.random() - 0.5) * 0.3
      });
    }

    for (let i = 0; i < BINARY_COUNT; i++) {
      binPts.push({
        x: (Math.random() - 0.5) * 1400,
        y: (Math.random() - 0.5) * 800,
        z: Math.random() * 300 + 750,
        char: Math.random() > 0.5 ? '1' : '0',
        vx: (Math.random() - 0.5) * 0.15,
        vy: (Math.random() - 0.5) * 0.1,
        vz: (Math.random() - 0.5) * 0.15,
        glowPhase: Math.random() * Math.PI * 2,
        glowSpeed: 0.02 + Math.random() * 0.02
      });
    }

    function animate() {
      // При reduced-motion рисуем один кадр и не запускаем постоянный цикл.
      if (!reducedMotion.matches && !document.hidden) {
        raf = requestAnimationFrame(animate);
      }

      const bgGrad = ctx!.createRadialGradient(cx, cy, 10, cx, cy, Math.max(w, h));
      bgGrad.addColorStop(0, '#030f24');
      bgGrad.addColorStop(1, '#010610');
      ctx!.fillStyle = bgGrad;
      ctx!.fillRect(0, 0, w, h);

      rx += (mx * 0.22 - rx) * 0.05;
      ry += (my * 0.15 - ry) * 0.05;

      const cosX = Math.cos(rx), sinX = Math.sin(rx);
      const cosY = Math.cos(ry), sinY = Math.sin(ry);
      const timeMs = Date.now();
      const autoTime = timeMs * 0.00004;
      const cosA = Math.cos(autoTime), sinA = Math.sin(autoTime);

      // 1. Бинарный фон.
      for (let i = 0; i < BINARY_COUNT; i++) {
        const bp = binPts[i];
        bp.x += bp.vx; bp.y += bp.vy; bp.z += bp.vz;
        if (Math.abs(bp.x) > 750) bp.vx *= -1;
        if (Math.abs(bp.y) > 450) bp.vy *= -1;
        if (bp.z < 650 || bp.z > 1050) bp.vz *= -1;

        const x1 = bp.x * cosA - (bp.z - 450) * sinA;
        const z1 = bp.x * sinA + (bp.z - 450) * cosA + 450;
        const x2 = x1 * cosX - (z1 - 450) * sinX;
        const z2 = x1 * sinX + (z1 - 450) * cosX + 450;
        const y2 = bp.y * cosY - (z2 - 450) * sinY;
        const z3 = bp.y * sinY + (z2 - 450) * cosY + 450;
        if (z3 <= 50) continue;

        const scale = 500 / z3;
        bp.glowPhase += bp.glowSpeed;
        const currentGlow = 0.15 + (Math.sin(bp.glowPhase) + 1) * 0.25;
        let sizeKey = 10;
        if (scale > 0.6) sizeKey = 24;
        else if (scale > 0.45) sizeKey = 18;
        else if (scale > 0.35) sizeKey = 14;

        const img = binCanvases[sizeKey][bp.char];
        const fog = Math.min(1, Math.max(0, (z3 - 450) / 800));
        ctx!.save();
        ctx!.globalAlpha = currentGlow * (1 - fog);
        ctx!.drawImage(img, (cx + x2 * scale) - img.width / 2, (cy + y2 * scale) - img.height / 2);
        ctx!.restore();
      }

      // 2. Структурированная сетка Plexus.
      const proj: Array<{x:number;y:number;z:number;blur:number;scale:number}> = [];
      for (let i = 0; i < N; i++) {
        const p = pts[i];
        p.x += p.vx; p.y += p.vy; p.z += p.vz;
        if (Math.abs(p.x) > 600) p.vx *= -1;
        if (Math.abs(p.y) > 250) p.vy *= -1;
        if (p.z < 100 || p.z > 850) p.vz *= -1;

        const x1 = p.x * cosA - (p.z - 450) * sinA;
        const z1 = p.x * sinA + (p.z - 450) * cosA + 450;
        const x2 = x1 * cosX - (z1 - 450) * sinX;
        const z2 = x1 * sinX + (z1 - 450) * cosX + 450;
        const y2 = p.y * cosY - (z2 - 450) * sinY;
        const z3 = p.y * sinY + (z2 - 450) * cosY + 450;
        if (z3 <= 50) continue;

        const scale = 500 / z3;
        const distFromFocus = Math.abs(z3 - 450);
        let blur = distFromFocus * 0.015;
        if (blur < 2.5) blur = 0;
        proj.push({ x: cx + x2 * scale, y: cy + y2 * scale, z: z3, blur, scale });
      }

      // Исходный полный перебор пар, без дополнительных структур оптимизации.
      ctx!.lineWidth = 0.85;
      for (let i = 0; i < proj.length; i++) {
        const p1 = proj[i];
        for (let j = i + 1; j < proj.length; j++) {
          const p2 = proj[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const currentMaxD = maxD * (p1.scale + p2.scale) * 0.3;
          if (dist < currentMaxD) {
            let alpha = 1 - dist / currentMaxD;
            const avgBlur = (p1.blur + p2.blur) / 2;
            alpha /= 1 + avgBlur * 0.8;
            if (alpha > 0.05) {
              const fog = Math.min(1, Math.max(0, (p1.z - 100) / 750));
              ctx!.strokeStyle = `rgba(130, 215, 255, ${alpha * 0.75 * (1 - fog * 0.4)})`;
              ctx!.beginPath();
              ctx!.moveTo(p1.x, p1.y);
              ctx!.lineTo(p2.x, p2.y);
              ctx!.stroke();
            }
          }
        }
      }

      // Чёткие вершины исходного варианта.
      for (let i = 0; i < proj.length; i++) {
        const p = proj[i];
        const size = Math.max(0.6, 2.5 * p.scale * 0.25);
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, size + p.blur * 0.3, 0, Math.PI * 2);
        const fog = Math.min(1, Math.max(0, (p.z - 100) / 750));
        const alpha = (1 - fog * 0.4) / (1 + p.blur * 0.8);
        ctx!.fillStyle = `rgba(200, 245, 255, ${alpha * 0.95})`;
        ctx!.fill();
      }
    }

    preRenderBinaries();
    raf = requestAnimationFrame(animate);

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(animate);
    });

    reducedMotion.addEventListener('change', () => {
      cancelAnimationFrame(raf);
      if (!document.hidden) raf = requestAnimationFrame(animate);
    });
  }
</script>
