---
import { withBase } from '../utils/paths';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = basePath ? (Astro.url.pathname.replace(basePath, '') || '/') : Astro.url.pathname;
const links = [
  { href: '/services', label: 'Услуги' },
  { href: '/solutions', label: 'Решения' },
  { href: '/blog', label: 'Блог' },
  { href: '/about', label: 'Обо мне' },
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={withBase("/")} aria-label="Mining-Dev — главная">
      <img class="brand-symbol" src={withBase("/quarry-mark.svg")} alt="" width="40" height="40" />
      <span class="brand-wordmark">Mining-Dev</span>
    </a>
    <nav id="primary-navigation" aria-label="Основная навигация">
      {links.map((link) => <a href={withBase(link.href)} aria-current={(link.href === '/blog' ? currentPath.startsWith('/blog') : currentPath === link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="nav-contact" href={withBase("/contacts")}>Обсудить задачу <span>↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-controls="primary-navigation" aria-expanded="false">☰</button>
  </div>
</header>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.site-header nav');
  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Открыть меню');
    nav?.classList.remove('is-open');
  };

  toggle?.addEventListener('click', () => {
    const opened = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!opened));
    toggle.setAttribute('aria-label', opened ? 'Открыть меню' : 'Закрыть меню');
    nav?.classList.toggle('is-open', !opened);
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
